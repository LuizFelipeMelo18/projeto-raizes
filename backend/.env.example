# Copie para .env e defina uma senha exclusiva para o PostgreSQL local.
SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:postgresql://localhost:5432/raizes
DB_USERNAME=raizes_app
DB_PASSWORD=troque_esta_senha
JWT_SECRET_BASE64=gere_32_bytes_aleatorios_em_base64
TEST_DB_URL=jdbc:postgresql://localhost:5432/raizes_test
TEST_DB_USERNAME=raizes_app
TEST_DB_PASSWORD=troque_esta_senha
SERVER_PORT=8080
